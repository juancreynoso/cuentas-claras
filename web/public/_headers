# Cabeceras de seguridad para los assets estáticos.
#
# La CSP es restrictiva a propósito: la app no carga scripts de terceros y sus
# únicas conexiones salientes son a su propio origen (la API). Lo único externo
# son las tipografías de Google Fonts.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# Los assets con hash en el nombre son inmutables: se pueden cachear para siempre.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
